# پورت سرور
PORT=4000

# آدرس فرانت‌اند (برای CORS)
FRONTEND_URL=http://localhost:5173

# --- زرین‌پال ---
# مرچنت آیدی خودتون رو از پنل zarinpal.com بگیرید
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000

# true برای محیط تست (sandbox)، false برای پرداخت واقعی
ZARINPAL_SANDBOX=true

# آدرسی که کاربر بعد از پرداخت به آن بازمی‌گردد
ZARINPAL_CALLBACK_URL=http://localhost:4000/api/payment/verify

# آدرس عمومی خود بک‌اند (برای لینک عکس‌های آپلودشده در فید ترب)
API_PUBLIC_URL=http://localhost:4000

# --- پنل مدیریت ---
# یک رشتهٔ طولانی و تصادفی برای امضای توکن‌های ورود بگذارید (مثلاً با: openssl rand -hex 32)
JWT_SECRET=change-this-to-a-long-random-string

# فقط برای اولین بار که دستور npm run create-admin را اجرا می‌کنید لازم است
ADMIN_EMAIL=admin@tosshop.ir
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=مدیر فروشگاه

# برای تولید توضیحات محصول با هوش مصنوعی در پنل مدیریت (اختیاری)
# کلید را از https://console.anthropic.com بگیرید
ANTHROPIC_API_KEY=
